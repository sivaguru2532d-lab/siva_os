<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 500" fill="none">
  <rect width="400" height="500" fill="#0a0a0a"/>
  <rect x="50" y="80" width="300" height="300" rx="150" fill="url(#grad)"/>
  <defs>
    <linearGradient id="grad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#1a1a1a"/>
      <stop offset="100%" stop-color="#0a0a0a"/>
    </linearGradient>
  </defs>
  <circle cx="200" cy="200" r="80" fill="none" stroke="rgba(255,255,255,0.1)" stroke-width="2"/>
  <circle cx="200" cy="180" r="50" fill="rgba(255,255,255,0.05)"/>
  <ellipse cx="200" cy="350" rx="90" ry="60" fill="rgba(255,255,255,0.03)"/>
  <text x="200" y="420" text-anchor="middle" font-family="system-ui, sans-serif" font-size="14" fill="rgba(255,255,255,0.3)">Replace with your photo</text>
  <text x="200" y="440" text-anchor="middle" font-family="system-ui, sans-serif" font-size="12" fill="rgba(255,255,255,0.2)">Update src/data/personal.ts</text>
</svg>